[TEMPLATE]
# Copy to .env.local and fill in locally. Never commit .env.local.
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_VISION_MODEL=meta/muse-spark-1.3
OPENROUTER_TEXT_MODEL=meta/muse-spark-1.3
# Web grounding on OpenRouter: set to true only if you want live web search.
OPENROUTER_WEB_SEARCH=false
APP_HOST=127.0.0.1
APP_PORT=18000